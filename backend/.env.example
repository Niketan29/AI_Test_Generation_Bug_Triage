# MagOneAI project API key (Project settings -> API keys). The secret is shown once at creation.
MAGONE_BASE_URL=https://trinity.magure.ai
MAGONE_API_KEY_ID=<api key id uuid>
MAGONE_API_SECRET=magk_...

# Optional: direct read access to the same PostgreSQL database the workflows write to (dashboard pages).
# Same database as the MagOneAI MCP connection "AI_TestCase_Bug_Triage".
# DATABASE_URL=postgresql://user:password@host:5432/dbname

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# App session signing key: any long random string. SESSION_DAYS: how long a login lasts.
APP_SECRET=change-me-to-a-long-random-string
SESSION_DAYS=7
# Trinity project whose members may sign in
TRINITY_PROJECT_ID=<project uuid>
